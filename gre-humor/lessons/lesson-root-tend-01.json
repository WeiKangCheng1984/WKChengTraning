      "minutes": 0.5,
      "content": "字根 tend/tens＝伸、張——拉力場專管拉長與張力。（有別於 ten＝握持）"
    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "extend 往外伸；contend 伸拳競爭。distend 脹開；tense／tension 拉緊。intense 強度拉滿；ostensible 表面上伸出來給人看。attend 把注意力伸過去；pretend 假裝伸一套戲。extensive 範圍伸很廣；tendency 傾向往哪伸。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "義錨 → 角色 → 跟讀英／中"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "tend＝伸：extend/contend/distend/tension/ostensible",
        "ostensible＝表面上的"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "sense",
      "promptEn": "Apparent; claimed on the surface:",
      "promptZh": "表面上的：",

      "content": "字根 mort＝死——登記處專管終點與瀕死。"
    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "mortal／mortality 會死與死亡率。immortal 不死。mortify 使羞愧欲死；moribund 瀕死。mortgage 抵押（把未來押死）；postmortem 事後檢討；mortuary 停屍間。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "義錨 → 角色 → 跟讀英／中"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "mort＝死：mortal/mortality/mortify/moribund/postmortem",
        "moribund＝瀕死／即將廢止"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "sense",
      "promptEn": "Near death; nearly obsolete:",
      "promptZh": "瀕死／即將廢止：",
      "choices": [
        "moribund",
        "mortal",
        "forte",
        "levity"
      ],
      "answer": "moribund"
    },
    {
      "id": "q2",
      "type": "sense",
      "promptEn": "After-the-fact review:",
      "promptZh": "事後檢討：",
      "choices": [
        "postmortem",
        "mortgage",
        "mortuary",
        "immortal"
      ],
      "answer": "postmortem"
    },
    {
      "id": "q3",
      "type": "sense",
      "promptEn": "Humiliate; shame deeply:",
      "promptZh": "使羞愧：",
      "choices": [
        "mortify",
        "mortality",
        "aggregate",
        "infuse"
      ],
      "answer": "mortify"
    }
  ],
  "pitfalls": [
    "mortify 常＝使羞愧，不只「殺死」",

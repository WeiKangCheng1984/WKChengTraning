      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "見 quiz（3 題）"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "duc＝引：conduct 帶領、induce 引出、deduce 推導、abduct 拐走",
        "educate＝把人引出無知；aqueduct＝引水之管"
      ]
    }
  ],
  "quiz": [

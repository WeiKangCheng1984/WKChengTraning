      "minutes": 0.5,
      "content": "字根 rupt＝破——哪裡一響，哪裡就裂。"
    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "談判 abrupt 突然中斷；制度 corrupt 從內部破爛。抗議 disrupt 打亂秩序，火山 erupt 噴出。bankrupt 破產，rupture 是裂口；interrupt 从中打斷，irrupt 衝破闖入。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "依 members 逐詞：義錨 → 劇本角色 → 跟讀 speakLineEn／對照 speakLineZh"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "見 quiz（3 題）"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "rupt＝破：abrupt 驟斷、corrupt 內爛、disrupt 打亂、erupt 噴出",
        "bankrupt＝銀行／帳面破裂；rupture＝裂口本身"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "sense",
      "promptEn": "Sudden and unexpected:",
      "promptZh": "突然且出人意料：",
      "choices": [
        "corrupt",
        "abrupt",
        "bankrupt",
        "rupture"
      ],
      "answer": "abrupt"
    },
    {
      "id": "q2",
      "type": "sense",
      "promptEn": "To break the normal flow or system:",

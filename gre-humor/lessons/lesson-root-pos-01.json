    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "propose 放上桌；impose 強加。compose 組裝，dispose 處置，expose 揭露，oppose 對放反對。postpone 往後放；component 零件，positive 明確肯定，deposit 存放。juxtapose 並置，superimpose 疊加，proposition 命題，exponent 倡導者，repository 儲庫。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "義錨 → 角色 → 跟讀英／中"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "pos＝放：propose/impose/compose/expose/oppose/postpone",
        "juxtapose＝並置對照"
      ]
    }
  ],
  "quiz": [

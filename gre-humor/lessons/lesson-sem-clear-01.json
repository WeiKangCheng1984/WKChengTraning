      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "清：lucid/explicit/transparent/perspicuous",
        "晦：obscure/opaque/vague/abstruse/recondite"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "contrast",
      "promptEn": "Easy to understand; clear:",
      "promptZh": "清晰易懂：",

        "abstruse",
        "opaque",
        "muddy"
      ],
      "answer": "lucid"
    },
    {
      "id": "q2",
      "type": "contrast",
      "promptEn": "Hard to see through (figurative):",
      "promptZh": "難看穿／不透明：",

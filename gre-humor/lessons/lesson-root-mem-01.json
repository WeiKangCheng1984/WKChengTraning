      "name": "鉤子",
      "minutes": 0.5,
      "content": "字根 mem＝記——櫃門一開：回憶、紀念、備忘錄全掉出來。"
    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "memoir 寫自己的記憶影集；memorable 值得放進櫃。commemorate 公開紀念；memento 小紀念品。immemorial 久到記不起起點；memorabilia 粉絲週邊山。memorandum 辦公室備忘；memorial 紀念碑；mnemonic 記憶口訣貼紙——櫃員說：記得住≠記得對。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "義錨 → 角色 → 跟讀英／中"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "mem＝記：memoir/memorable/commemorate/memento/immemorial/mnemonic",
        "immemorial＝遠古難記"
      ]
    }
  ],
  "quiz": [

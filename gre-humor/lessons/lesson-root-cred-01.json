      "step": 1,
      "name": "鉤子",
      "minutes": 0.5,
      "content": "字根 cred＝信——這裡只收『可信度』當貨幣。"
    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "說法要 credible 才收得進；credulous 人什麼都信，incredulous 人怎麼都不信。credential 是信用證件，credit 是信用額度。credence 是給予相信，credo 是信條；discredit 讓人失去信用。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "依 members 逐詞：義錨 → 劇本角色 → 跟讀 speakLineEn／對照 speakLineZh"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "見 quiz（3 題）"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "cred＝信：credible 可信、credulous 輕信、incredulous 不信、discredit 抹黑失信",
        "credential＝證明你可信的證件；credo＝你信什麼"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "lookalike",
      "promptEn": "A person who refuses to believe is:",
      "promptZh": "不肯相信的人是：",
      "choices": [
        "incredible",
        "incredulous",
        "credulous",
        "accredited"
      ],
      "answer": "incredulous"
    },
    {
      "id": "q2",
      "type": "sense",
      "promptEn": "Too ready to believe:",
      "promptZh": "太容易相信：",
      "choices": [
        "credulous",
        "credible",
        "discredit",
        "credo"
      ],
      "answer": "credulous"
    },
    {
      "id": "q3",
      "type": "sense",
      "promptEn": "To damage someone’s reputation for truth:",
      "promptZh": "損害某人的可信聲譽：",
      "choices": [
        "credit",
        "discredit",
        "credence",
        "credential"
      ],
      "answer": "discredit"
    }
  ],
  "pitfalls": [

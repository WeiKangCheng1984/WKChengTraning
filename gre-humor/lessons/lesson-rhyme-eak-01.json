      "name": "快測",
      "minutes": 2,
      "content": "見 quiz（3 題）"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "leak 宇宙：sneak→wreak→bleak→streak；evoke↔revoke",
        "evoke 喚起／revoke 收回——方向相反"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "sense",
      "promptEn": "To cause severe damage or havoc is to:",
      "promptZh": "造成嚴重破壞／浩劫，是：",
      "choices": [
        "sneak",
        "wreak",
        "evoke",
        "revoke"
      ],
      "answer": "wreak"
    },
    {
      "id": "q2",
      "type": "sense",
      "promptEn": "evoke : bring to mind :: revoke :",
      "promptZh": "evoke 是喚起，revoke 最接近：",
      "choices": [
        "renew",
        "cancel / withdraw",
        "echo",
        "remind"
      ],
      "answer": "cancel / withdraw"
    },
    {
      "id": "q3",
      "type": "sense",
      "promptEn": "A future that looks cold and hopeless is:",
      "promptZh": "看起來冰冷無望的前景是：",
      "choices": [
        "bleak",
        "streak",
        "sneak",
        "wreak"
      ],
      "answer": "bleak"
    }
  ],
  "pitfalls": [
    "wreak 常接 havoc；不要寫成 wreck 的拼法混用（語境不同）",

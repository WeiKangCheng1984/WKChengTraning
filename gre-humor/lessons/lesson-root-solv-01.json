    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "solve 解開；dissolve 溶解散去。resolve 下決心解開／決議；absolve 解除罪責。soluble 可溶，solvent 溶劑／有償債力。solution 解方；irresolute 猶豫不解。resolute 堅決；dissolute 放蕩無約束像道德溶解。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "義錨 → 角色 → 跟讀英／中"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "solv＝解：solve/dissolve/resolve/absolve/soluble",
        "absolve＝解除罪責"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "sense",
      "promptEn": "Free from blame:",
      "promptZh": "解除罪責：",
      "choices": [
        "absolve",
        "dissolve",
        "soluble",
        "dissolute"
      ],
      "answer": "absolve"
    },
    {
      "id": "q2",
      "type": "lookalike",
      "promptEn": "Firm vs hesitant:",
      "promptZh": "堅決 vs 猶豫：",
      "choices": [
        "resolute / irresolute",
        "irresolute / resolute",
        "solve / solution",
        "solvent / soluble"
      ],
      "answer": "resolute / irresolute"
    },
    {
      "id": "q3",
      "type": "sense",
      "promptEn": "Morally loose; dissipated:",
      "promptZh": "放蕩：",

  "titleEn": "Victory Arena",
  "flow": [
    {
      "step": 1,
      "name": "鉤子",
      "minutes": 0.5,
      "content": "字根 vinc/vict＝勝——競技場專管誰被說服、誰被擊敗。"
    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "victor／victory 勝者。convict 定罪勝過辯護；evict 趕出勝出空間。convince 說服取勝；invincible 打不敗。vanquish 徹底打垮；provincial 眼界窄像地方小勝。eviction 驅逐令；conviction 信念／定罪；victorious 勝利的。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "義錨 → 角色 → 跟讀英／中"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "vict＝勝：victor/convict/evict/convince/invincible/vanquish",
        "convict 可作動詞定罪或名詞囚犯"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "sense",
      "promptEn": "Persuade:",
      "promptZh": "說服：",
      "choices": [
        "convince",
        "evict",
        "provincial",
        "victor"
      ],
      "answer": "convince"
    },
    {
      "id": "q2",
      "type": "sense",
      "promptEn": "Narrow in outlook:",
      "promptZh": "眼界狹窄：",
      "choices": [
        "provincial",
        "invincible",
        "victory",
        "eviction"
      ],
      "answer": "provincial"
    },
    {
      "id": "q3",
      "type": "sense",
      "promptEn": "Defeat completely:",
      "promptZh": "徹底擊敗：",
      "choices": [
        "vanquish",
        "convict",
        "convince",
        "victorious"
      ],
      "answer": "vanquish"
    }
  ],
  "pitfalls": [
    "provincial 常指眼界狹窄，不只「省的」",
    "conviction＝信念或定罪，看語境"
  ],

  "titleEn": "Name-Tag Locker",
  "flow": [
    {
      "step": 1,
      "name": "鉤子",
      "minutes": 0.5,
      "content": "字根 nym/nomen＝名——更衣室專管掛什麼名牌。"
    },
    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "anonymous 不掛名；pseudonym 掛假名。synonym 同義名牌，antonym 反義名牌。misnomer 叫錯名；ignominy 臭名。nominal 名義上的；renown 大名。nomenclature 整套命名系統；homonym 同音異義的撞名。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "義錨 → 角色 → 跟讀英／中"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "nym＝名：anonymous/pseudonym/synonym/antonym/misnomer",
        "nominal＝名義上"
      ]
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "type": "sense",
      "promptEn": "Wrong or inaccurate name:",
      "promptZh": "誤稱：",
      "choices": [
        "misnomer",
        "synonym",
        "acronym",
        "renown"
      ],
      "answer": "misnomer"
    },
    {
      "id": "q2",
      "type": "sense",
      "promptEn": "In name only:",
      "promptZh": "名義上的：",
      "choices": [
        "nominal",
        "anonymous",
        "antonym",
        "homonym"
      ],
      "answer": "nominal"
    },
    {
      "id": "q3",
      "type": "sense",
      "promptEn": "Public disgrace:",
      "promptZh": "恥辱臭名：",
      "choices": [
        "ignominy",
        "pseudonym",
        "nomenclature",
        "anonymity"
      ],
      "answer": "ignominy"
    }
  ],
  "pitfalls": [
    "misnomer＝名稱不當，不是「失誤」泛稱",
    "ignominy＝恥辱臭名"
  ],

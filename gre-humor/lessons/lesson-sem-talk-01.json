      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "少話：taciturn/reticent/laconic；多話：loquacious/garrulous/verbose",
        "laconic＝短而精；verbose＝長而肥"
      ]
    }
  ],
  "quiz": [

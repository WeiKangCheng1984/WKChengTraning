    {
      "step": 2,
      "name": "串記劇本",
      "minutes": 2,
      "content": "sequence 順序跟著；consequence 跟著來的後果。subsequent 隨後；consecutive 連續跟著。prosecute 依法追擊，persecute 無理追打。obsequious 諂媚跟太緊；execute 執行跟上命令。segue 平滑接下一段；non sequitur 跟不上邏輯的句子。"
    },
    {
      "step": 3,
      "name": "詞卡 round",
      "minutes": 7,
      "content": "義錨 → 角色 → 跟讀英／中"
    },
    {
      "step": 4,
      "name": "快測",
      "minutes": 2,
      "content": "quiz ×3"
    },
    {
      "step": 5,
      "name": "口令帶走",
      "minutes": 0.5,
      "content": [
        "sequ＝跟：sequence/consequence/subsequent/consecutive",
        "prosecute 檢控 ≠ persecute 迫害"
      ]
    }
  ],
  "quiz": [

  "phrases": [
    {
      "id": "re-phrase-1",
      "en": "We're under contract, with closing in six weeks.",
      "zh": "我們已簽約，預計六週後成交。"
    },
    {
      "id": "re-phrase-2",
      "en": "The bones are good; most of this is deferred maintenance.",
      "zh": "底子不錯；多半是延宕維護。"
    },
    {
      "id": "re-phrase-3",
      "en": "We're asking for a repair credit instead of seller repairs.",
      "zh": "我們要求維修折讓，而不是賣方施工。"
    },
    {
      "id": "re-phrase-4",
      "en": "If the appraisal comes in low, we'll renegotiate or walk.",
      "zh": "若估價偏低，我們會重談或退出。"
    },
    {
      "id": "re-phrase-5",
      "en": "Keep the inspection contingency—it's not optional for me.",
      "zh": "驗屋附條件一定要留，對我不是可選項。"
    },
    {
      "id": "re-phrase-6",
      "en": "Please send the HOA docs and the T-12 when you can.",
      "zh": "請在方便時寄社區文件與 T-12。"
    },
    {
      "id": "re-phrase-7",
      "en": "The AC is running but not cooling.",
      "zh": "空調有在轉但不冷。"
    },
    {
      "id": "re-phrase-8",
      "en": "Confirming we're still on for Friday's showing at 10.",
      "zh": "確認週五早上十點帶看仍照常。"
    }
  ]
}
